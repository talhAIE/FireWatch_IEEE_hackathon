# Template only. Copy to .env locally; never commit real credentials.
# Native setup generates required local secrets. Missing/placeholder DB and admin secrets fail startup.
# FIRMS is optional until ingestion. Chain reads need RPC/address; only the signer needs a key.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://firewatch:REPLACE_ME@localhost:5432/firewatch
POSTGRES_DB=firewatch
POSTGRES_USER=firewatch
POSTGRES_PASSWORD=REPLACE_ME
FIRMS_MAP_KEY=REPLACE_ME
ADMIN_API_TOKEN=REPLACE_WITH_RANDOM_SECRET
CORS_ORIGINS=[]
REGIONS_CONFIG=configs/regions.yaml
RAW_DATA_DIR=data/raw
MODEL_DIR=models
# Use registry only after a reviewed model is promoted; explicit baselines bypass it.
ACTIVE_SCORER=baseline-v1
REFRESH_INTERVAL_MINUTES=15
WEATHER_CACHE_GRID_DEGREES=0.1
WEATHER_MAX_AGE_HOURS=3
CLUSTER_RADIUS_KM=2
SNAPSHOT_LOOKBACK_HOURS=6
LABEL_HORIZON_HOURS=24
FEATURE_SCHEMA_VERSION=features-v1
EVIDENCE_SCHEMA_VERSION=evidence-v1
CHAIN_ENABLED=false
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
ALERT_REGISTRY_ADDRESS=
CHAIN_PRIVATE_KEY=
CHAIN_NETWORK_KIND=local
# Internal Compose hosts require an explicit allowlist; native defaults remain loopback-only.
CHAIN_LOCAL_RPC_HOSTS=["127.0.0.1","localhost","::1"]
CHAIN_CONFIRMATIONS=2
CHAIN_RPC_TIMEOUT_SECONDS=3
CHAIN_POLL_SECONDS=5
CHAIN_RECHECK_SECONDS=60
CHAIN_MAX_ATTEMPTS=20
CHAIN_GAS_LIMIT=100000
CHAIN_MAX_GAS_PRICE_WEI=200000000000
PUBLIC_API_HOSTNAME=

# Per-process pool bounds and database timeouts.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=30000
STARTUP_TIMEOUT_SECONDS=120
STARTUP_RETRY_SECONDS=1

# Prototype read APIs expose sanitized research results; false requires operator auth.
PUBLIC_READS_ENABLED=true

# Operator queue/input bounds; replay scenarios are trusted server configuration.
REPLAYS_CONFIG=configs/replays.yaml
MAX_REQUEST_BODY_BYTES=16384
REQUEST_BODY_TIMEOUT_SECONDS=5
MAX_JOB_QUEUE_DEPTH=100
QUEUE_LOCK_TIMEOUT_MS=3000
MAX_REFRESH_WINDOW_HOURS=48
MAX_REFRESH_AGE_HOURS=72
MAX_REPLAY_WINDOW_DAYS=31
MAX_REGION_AREA_DEGREES2=100

# Dedicated worker (never schedule inside Uvicorn).
FEATURES_CONFIG=configs/features-v1.yaml
WORKER_MAX_ATTEMPTS=5
WORKER_LEASE_SECONDS=120
WORKER_POLL_SECONDS=2
WORKER_RETRY_SECONDS=30
WORKER_HEALTH_MAX_LAG_SECONDS=600
# Optional private FIRMS key overrides can be saved in ignored .env.firms.
DETECTION_MAX_AGE_HOURS=24

# Portable, offline historical replay bundles.
REPLAY_BUNDLE_DIR=data/replays
