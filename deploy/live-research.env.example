# Apply to BOTH a dedicated API and worker, never silently to the replay deployment.
# Supply DATABASE_URL and ADMIN_API_TOKEN through the existing private environment.
APP_ENV=production
ACTIVE_SCORER=registry
LIVE_SCORER=baseline-v1
FIRMS_MAP_KEY=REPLACE_WITH_PRIVATE_FIRMS_KEY
REGIONS_CONFIG=configs/regions-live-research.yaml
RAW_DATA_DIR=/var/lib/firewatch/raw
MODEL_DIR=/app/deploy/render/model
SOURCE_ARTIFACT_DIR=/app/deploy/render/assets
REPLAY_BUNDLE_DIR=/var/lib/firewatch/replays
PUBLIC_READS_ENABLED=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
DB_CONNECT_TIMEOUT_SECONDS=30
WORKER_POLL_SECONDS=15
REFRESH_INTERVAL_MINUTES=15
CHAIN_ENABLED=false
