# Public sanitized READS only. Operator writes always require private bearer auth.
APP_ENV=production
ACTIVE_SCORER=registry
PUBLIC_READS_ENABLED=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
MODEL_DIR=/app/deploy/render/model
SOURCE_ARTIFACT_DIR=/app/deploy/render/assets
CHAIN_ENABLED=false
